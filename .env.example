PORT=5174
NODE_ENV=development
DOWNLOADS_DIR=downloads
DATA_DIR=data
THUMBNAILS_DIR=data/thumbnails

# Timeouts (Millisekunden)
ANALYZE_TIMEOUT_MS=60000
DOWNLOAD_TIMEOUT_MS=300000

# Optional: Desktop-User-Agent erzwingen (1 = an). Standard aus, da er bei
# Instagram die Bot-Erkennung auslösen kann.
USE_DESKTOP_UA=0

# Cookies für Inhalte, die Login erfordern (z. B. viele Instagram-/Facebook-
# Videos). Nur für eigene oder erlaubte Inhalte verwenden.
# Variante A: Pfad zu einer Netscape-Cookie-Datei (lokal oder Render Secret File)
# YTDLP_COOKIES_FILE=/etc/secrets/cookies.txt
# Variante B: Cookie-Inhalt direkt als Env-Variable (praktisch auf Render)
# YTDLP_COOKIES=
# Variante C: nur lokal – Cookies direkt aus dem Browser ziehen
# YTDLP_COOKIES_FROM_BROWSER=chrome
